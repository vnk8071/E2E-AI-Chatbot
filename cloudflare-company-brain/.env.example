# Copy to .env (git-ignored): cp .env.example .env
# `wrangler dev` loads .env automatically and exposes these as Worker vars/secrets.
# Values here override the defaults in wrangler.jsonc for local runs only.
# For a deployed Worker, set secrets with: npx wrangler secret put ADMIN_TOKEN

# Bearer token required by POST /api/ingest. Use a long random value outside local dev.
ADMIN_TOKEN=change-me

# AI Gateway id. Leave EMPTY to call Workers AI directly (no gateway needed locally).
# When set, the gateway must already exist (scripts/configure-gateway.sh creates it)
# and you get caching, analytics and Llama Guard Guardrails.
GATEWAY_ID=

# --- Optional tunables (defaults live in wrangler.jsonc) ---
# MIN_SCORE=0.55            # minimum Vectorize similarity before the LLM is called
# RATE_LIMIT_PER_MIN=20     # per-IP requests per minute
# CACHE_TTL_SECONDS=3600    # how long identical questions are served from KV
# CHAT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# EMBED_MODEL=@cf/baai/bge-base-en-v1.5

# --- Only for scripts/configure-gateway.sh (prefer `export` in your shell) ---
# Do NOT put the API token in .env if you run `wrangler dev`: every .env value becomes a
# local Worker binding. Token needs "AI Gateway: Edit" permission.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
